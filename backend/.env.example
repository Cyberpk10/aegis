# Copy this file to .env and fill in real values. .env is gitignored — never commit real secrets.

# Required only when ENABLE_LLM_REASONING=true. Never hardcode this in source.
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Turns on the optional AI analyst narrative (backend/app/reasoning/llm_analyst.py).
# Off by default so the app and pytest suite stay fully offline/deterministic.
ENABLE_LLM_REASONING=false

# Overrides the model used for the analyst narrative.
ANTHROPIC_MODEL=claude-haiku-4-5

# SQLAlchemy database URL. Defaults to a local SQLite file so the app and pytest suite run
# with zero setup. Point this at the docker-compose Postgres for a real deployment, e.g.:
#   DATABASE_URL=postgresql+psycopg://aegis:aegis@localhost:5432/aegis
DATABASE_URL=sqlite:///./aegis.db

# Directory where raw .eml uploads are stored on disk. The `cases` table stores only a
# pointer to this path — never the raw email itself (data minimization).
RAW_EMAIL_STORAGE_DIR=./data/raw_emails

# How many days a raw .eml is kept on disk before being purged. Purge runs best-effort at
# backend startup; you can also run it on a schedule (cron/systemd timer).
RAW_EMAIL_RETENTION_DAYS=30

# Stub identity recorded as `labeled_by` on analyst feedback (POST /api/cases/{id}/label)
# when the request doesn't send an X-Analyst-Id header. Not real auth — a placeholder until
# Aegis has actual analyst accounts.
DEFAULT_ANALYST_ID=anonymous-analyst
