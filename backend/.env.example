# Copy this file to .env and fill in real values. .env is gitignored — never commit real secrets.

# Required only when ENABLE_LLM_REASONING=true. Never hardcode this in source.
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Turns on the optional AI analyst narrative (backend/app/reasoning/llm_analyst.py).
# Off by default so the app and pytest suite stay fully offline/deterministic.
ENABLE_LLM_REASONING=false

# Overrides the model used for the analyst narrative.
ANTHROPIC_MODEL=claude-haiku-4-5
