# Local persistence (Stage 2)
backend/aegis.db
backend/data/

# ML training corpus / artifacts (M3) — never commit raw datasets; ml/models/ is ignored except
# for the committed documentation (CARD.md, metrics.json) carved out below. The actual binary
# model artifacts live in backend/app/ml/artifacts/ instead (see that directory) — not ignored,
# since Docker's build context can only see files inside backend/.
ml/data/
ml/models/*
!ml/models/CARD.md
!ml/models/metrics.json
